<Window x:Class="TransportTaskSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транспортная задача" Height="750" Width="1050"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Панель выбора размеров -->
        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Поставщиков:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <ComboBox x:Name="CmbRows" Width="50" SelectedIndex="1">
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem>
                <ComboBoxItem>6</ComboBoxItem>
            </ComboBox>

            <TextBlock Text="Потребителей:" VerticalAlignment="Center" Margin="20,0,5,0"/>
            <ComboBox x:Name="CmbCols" Width="50" SelectedIndex="2">
                <ComboBoxItem>2</ComboBoxItem>
                <ComboBoxItem>3</ComboBoxItem>
                <ComboBoxItem>4</ComboBoxItem>
                <ComboBoxItem>5</ComboBoxItem>
                <ComboBoxItem>6</ComboBoxItem>
            </ComboBox>

            <Button x:Name="BtnBuildGrid" Content="Построить таблицу" 
                    Margin="20,0,0,0" Padding="10,3" Click="BtnBuildGrid_Click"/>
        </StackPanel>

        <!-- Контейнер для динамической сетки ввода -->
        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" 
                Margin="0,0,0,10" Padding="10" Background="#F9F9F9">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid x:Name="GridInput" HorizontalAlignment="Left" VerticalAlignment="Top"/>
            </ScrollViewer>
        </Border>

        <!-- Панель кнопок расчета -->
        <WrapPanel Grid.Row="2" Margin="0,0,0,10">
            <Button Content="Метод Северо-Западного угла" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnNorthWest_Click"/>
            <Button Content="Метод Минимальных элементов" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnMinElement_Click"/>
            <Button Content="Метод потенциалов (Оптимизация)" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnPotential_Click"/>

            <Button Content="Очистить поля" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnClear_Click"/>
            <Button Content="Загрузить из Excel" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnLoadExcel_Click"/>
            <Button Content="Выгрузить в Excel" Padding="8,5" Margin="0,0,8,8"
                    Click="BtnSaveExcel_Click"/>
        </WrapPanel>

        <!-- Статус расчета -->
        <TextBlock x:Name="TxtStatus" Grid.Row="3" Text="Готово" Margin="0,0,0,5" FontWeight="Bold" Foreground="DarkBlue"/>

        <!-- Таблица результатов -->
        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="ResultGrid" AutoGenerateColumns="True" IsReadOnly="True" 
                      GridLinesVisibility="All" HeadersVisibility="All"/>
            <TextBlock x:Name="TxtTotalCost" Grid.Row="1" Text="Общая стоимость: 0" 
                       Margin="0,8,0,0" FontWeight="Bold" FontSize="14"/>
        </Grid>
    </Grid>
</Window>