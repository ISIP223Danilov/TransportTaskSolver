<Window x:Class="TransportTaskSolver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Транспортная задача" Height="700" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <GroupBox Header="Ввод данных" Grid.Row="0" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Margin="10">
                <StackPanel Margin="5">
                    <Label Content="Запасы (a1, a2, a3) через пробел:"/>
                    <TextBox x:Name="TxtSupplies" Width="200" Text="200 350 300"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <Label Content="Потребности (b1..b5) через пробел:"/>
                    <TextBox x:Name="TxtDemands" Width="250" Text="270 130 190 150 110"/>
                </StackPanel>
                <StackPanel Margin="5">
                    <Label Content="Матрица тарифов (3 строки):"/>
                    <TextBox x:Name="TxtCosts" Width="350" Height="60" AcceptsReturn="True" TextWrapping="Wrap" 
                             Text="24 50 55 27 16&#x0a;50 47 23 17 21&#x0a;35 59 55 27 41"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>


        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="BtnNorthWest" Content="Метод Северо-Западного угла" Width="227" Height="30" Click="BtnNorthWest_Click"/>
            <Button x:Name="BtnMinElement" Content="Метод Минимальных элементов" Width="220" Height="30" Margin="5" Click="BtnMinElement_Click"/>
            <Button x:Name="BtnPotential" Content="Метод потенциалов (Оптимизация)" Width="225" Height="30" Click="BtnPotential_Click"/>
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center" Margin="20,0,0,0" FontWeight="Bold" Foreground="Blue"/>
        </StackPanel>


        <DataGrid x:Name="ResultGrid" Grid.Row="2" AutoGenerateColumns="True" IsReadOnly="True" 
                  CanUserAddRows="False" HeadersVisibility="All" GridLinesVisibility="All" Margin="0,0,0,10"/>

        <TextBlock x:Name="TxtTotalCost" Grid.Row="3" FontSize="16" FontWeight="Bold" 
                   Text="Общая стоимость: 0" HorizontalAlignment="Right"/>
    </Grid>
</Window>
